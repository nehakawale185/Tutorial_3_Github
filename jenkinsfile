pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
               echo 'Running tests...'
            }
        }
        stage('Run application') {
            steps {
                        echo 'run application'
                        echo 'python app.py'
                }
            }

    }
}
